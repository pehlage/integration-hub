{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": { "Provider": "Postgres" },
  "ConnectionStrings": {
    "Hub": "Host=localhost;Port=5432;Database=integration_hub;Username=hub;Password=hub"
  },
  "MockErp": { "BaseUrl": "http://localhost:5080" },
  "ErpHttp": { "MaxConcurrencyPerHost": 4, "MinIntervalMs": 50 },
  "Hangfire": { "Server": true, "Workers": 4 },
  "Cors": { "Origins": [ "http://localhost:5173", "http://localhost:8080" ] },
  "Proxy": {
    "ApiKey": "troque-esta-chave",
    "AllowedHosts": [ "httpbin.org", "api.github.com" ],
    "MaxTimeoutSeconds": 120
  }
}
